# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# --- Node / Next.js ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
frontend/.vercel/
frontend/.pnpm-store/
frontend/*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/*.log
backend/*.log

# --- Java / backend build output ---
backend/out/
backend/bin/
backend/build/
backend/**/*.class
backend/*.class

# --- Environment files ---
.env
.env.*
!.env.example

# --- Production / temporary ---
/build
/out/
coverage/
*.pem
